#!/usr/bin/env bash
# nginx-mcp-writesite - narrow helper for nginx-certbot-mcp.
# Only ever touches /etc/nginx/sites-available/<domain>,
# /etc/nginx/sites-enabled/<domain>, /etc/nginx/sites-archived/<domain>.<timestamp>,
# /etc/nginx/sites-backups/<domain>.<timestamp>, and (read-only, capped) the two fixed nginx log files - nothing else on the filesystem.
set -euo pipefail

SITES_AVAILABLE="/etc/nginx/sites-available"
SITES_ENABLED="/etc/nginx/sites-enabled"
ARCHIVE_DIR="/etc/nginx/sites-archived"
BACKUP_DIR="/etc/nginx/sites-backups"
BACKUP_KEEP=10 # snapshots kept per domain; older ones are deleted on each new backup
ACCESS_LOG="/var/log/nginx/access.log"
ERROR_LOG="/var/log/nginx/error.log"
DOMAIN_RE='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'

usage() {
  echo "Usage: $0 {write|enable|disable|remove|archive|restore|remove-archive|backup|restore-backup} <domain> [filename]" >&2
  echo "       $0 log {access|error} <lines>" >&2
  exit 1
}

[ $# -ge 1 ] || usage
ACTION="$1"

# `log` doesn't take a domain - handle it before the domain validation below.
if [ "$ACTION" = "log" ]; then
  [ $# -eq 3 ] || usage
  LOG_TYPE="$2"
  LINES="$3"
  [[ "$LINES" =~ ^[0-9]{1,4}$ ]] || { echo "Invalid line count: $LINES" >&2; exit 1; }
  [ "$LINES" -gt 1000 ] && LINES=1000
  case "$LOG_TYPE" in
    access) tail -n "$LINES" "$ACCESS_LOG" ;;
    error)  tail -n "$LINES" "$ERROR_LOG" ;;
    *) echo "Invalid log type: $LOG_TYPE (must be access|error)" >&2; exit 1 ;;
  esac
  exit 0
fi

[ $# -ge 2 ] || usage
DOMAIN="$2"

# Re-validates the domain independently of the Node code that calls this -
# defense in depth, since this script is the actual privilege boundary.
[[ "$DOMAIN" =~ $DOMAIN_RE ]] || { echo "Invalid domain: $DOMAIN" >&2; exit 1; }

AVAILABLE_PATH="$SITES_AVAILABLE/$DOMAIN"
ENABLED_PATH="$SITES_ENABLED/$DOMAIN"

# Shared by restore/remove-archive/restore-backup/backup pruning: only ever
# touch a file that's exactly "<domain>.<14-digit-timestamp>", named via a glob
# rather than a regex so a path-traversal attempt (containing "/" or "..") can
# never match.
is_snapshot_name() {
  case "$1" in
    "$DOMAIN".[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]) return 0 ;;
    *) return 1 ;;
  esac
}
validate_archive_filename() {
  is_snapshot_name "$1" || { echo "Invalid archive filename: $1" >&2; exit 1; }
}

case "$ACTION" in
  write)   cat > "$AVAILABLE_PATH" ;;             # content piped via stdin
  enable)  ln -sf "$AVAILABLE_PATH" "$ENABLED_PATH" ;;
  disable) rm -f "$ENABLED_PATH" ;;
  remove)  rm -f "$AVAILABLE_PATH" ;;
  # Copies the live config aside before delete_site deletes it, so a
  # mistaken removal can be restored by hand instead of being unrecoverable.
  archive)
    [ -f "$AVAILABLE_PATH" ] || { echo "No config to archive for $DOMAIN" >&2; exit 1; }
    mkdir -p "$ARCHIVE_DIR"
    cp -p "$AVAILABLE_PATH" "$ARCHIVE_DIR/$DOMAIN.$(date +%Y%m%dT%H%M%S)"
    ;;
  # Copies an archived config back into sites-available. Node picks which
  # archive file (usually the newest) and passes its exact filename as $3.
  restore)
    ARCHIVE_FILE="${3:?Usage: $0 restore <domain> <archive_filename>}"
    validate_archive_filename "$ARCHIVE_FILE"
    SRC="$ARCHIVE_DIR/$ARCHIVE_FILE"
    [ -f "$SRC" ] || { echo "No such archive: $ARCHIVE_FILE" >&2; exit 1; }
    cp -p "$SRC" "$AVAILABLE_PATH"
    ;;
  # Permanently deletes one archived config - used by prune_archives.
  remove-archive)
    ARCHIVE_FILE="${3:?Usage: $0 remove-archive <domain> <archive_filename>}"
    validate_archive_filename "$ARCHIVE_FILE"
    rm -f "$ARCHIVE_DIR/$ARCHIVE_FILE"
    ;;
  # Snapshots the current config before create_site/update_site/restore_site/
  # rollback_site change it, so any of them can be undone. Keeps the newest
  # BACKUP_KEEP per domain.
  backup)
    [ -f "$AVAILABLE_PATH" ] || { echo "No config to back up for $DOMAIN" >&2; exit 1; }
    mkdir -p "$BACKUP_DIR"
    cp -p "$AVAILABLE_PATH" "$BACKUP_DIR/$DOMAIN.$(date +%Y%m%dT%H%M%S)"
    KEPT=0
    for f in $(ls -1r "$BACKUP_DIR"); do
      if is_snapshot_name "$f"; then
        KEPT=$((KEPT + 1))
        if [ "$KEPT" -gt "$BACKUP_KEEP" ]; then rm -f "$BACKUP_DIR/$f"; fi
      fi
    done
    ;;
  # Copies a backup back into sites-available. Node picks which one and passes
  # its exact filename as $3.
  restore-backup)
    BACKUP_FILE="${3:?Usage: $0 restore-backup <domain> <backup_filename>}"
    validate_archive_filename "$BACKUP_FILE"
    SRC="$BACKUP_DIR/$BACKUP_FILE"
    [ -f "$SRC" ] || { echo "No such backup: $BACKUP_FILE" >&2; exit 1; }
    cp -p "$SRC" "$AVAILABLE_PATH"
    ;;
  *) usage ;;
esac
