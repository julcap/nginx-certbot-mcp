{
  "name": "nginx-certbot-mcp",
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "description": "MCP server to read nginx config and manage reverse proxy hosts + SSL certs via certbot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "setup": "bash scripts/setup.sh",
    "install:wrapper": "bash scripts/install.sh",
    "install:sudoers": "bash scripts/install-sudoers.sh",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "check-deps": "bash scripts/install-deps.sh",
    "test:dns": "npm run build && node tests/test-dns-roundtrip.mjs",
    "test:tools": "npm run build && node tests/test-tools.mjs",
    "test:tools:host": "npm run build && node tests/test-tools.mjs --host"
  },
  "dependencies": {
    "@aws-sdk/client-route-53": "^3.1132.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.16.5",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
