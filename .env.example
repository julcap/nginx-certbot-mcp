# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# Route-53-scoped IAM user - no other AWS permissions needed. Used by create_domain_record.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Find with: aws route53 list-hosted-zones-by-name --dns-name julcap.net
ROUTE53_HOSTED_ZONE_ID=

# Route 53 is global, but the AWS SDK still needs a signing region. Optional -
# defaults to us-east-1 if left blank.
AWS_DEFAULT_REGION=

# Audit log of tool calls (JSONL). Default: ~/.nginx-certbot-mcp/audit.jsonl
# Set to "off" to disable. The server won't start if the file isn't writable.
AUDIT_LOG_PATH=
# Also log read-only calls (default: mutating calls only).
AUDIT_LOG_READS=
