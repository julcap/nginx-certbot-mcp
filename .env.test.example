# Copy to .env.test and fill in. .env.test is gitignored - never commit real credentials.
#
# Used only by `npm run test:tools` (tests/test-tools.mjs), the automated
# tool-by-tool test runner. It's separate from .env: this file's credentials
# get injected straight into each `docker compose exec` call the runner
# makes, so it never needs to match whatever .env the sandbox container was
# started with.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Same zone as .env's ROUTE53_HOSTED_ZONE_ID, or a different one - either
# way the runner verifies TEST_DOMAIN actually lives in this zone before
# doing anything else.
ROUTE53_HOSTED_ZONE_ID=

# Route 53 is global, but the AWS SDK still needs a signing region. Optional -
# defaults to us-east-1 if left blank.
AWS_DEFAULT_REGION=

# A domain you control in the hosted zone above, e.g. "julcap.net" or
# "sub.julcap.net". The runner never touches this domain directly - every
# test runs under a random "mcp-test-<random>.<TEST_DOMAIN>" subdomain and
# cleans it up afterward.
TEST_DOMAIN=
